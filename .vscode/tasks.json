{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ compilar com arquivos especificados",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/main.cpp",  
                "${workspaceFolder}/drawsModule/drawInfiniteLines/main.cpp",  
                "${workspaceFolder}/drawsModule/drawStreets/main.cpp",  
                "${workspaceFolder}/objectsModule/createStreet/main.cpp",  
                "${workspaceFolder}/utils/calculateWorldCoordinates/main.cpp", 
                "-o",
                "${workspaceFolder}/ueize",
                "-lglut",
                "-lGLU",
                "-lGL",
                "-lm",
                "-lglfw",
                "-lGLEW"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Tarefa gerada pelo Depurador."
        }
    ],
    "version": "2.0.0"
